# Deny by default. Add exact, approved pre-experiment documents only.
*
!/.gitignore
!/.github/
!/GITHUB_PROGRESS.md
/.github/*
!/.github/README.md

# Pre-experiment statistics tools backing section 4.5. Directory re-denied so
# that only these named files enter; __pycache__ and unreviewed scripts stay out.
!/pre_experiment_tools/
/pre_experiment_tools/*
!/pre_experiment_tools/paired_hoeffding.py
!/pre_experiment_tools/test_paired_hoeffding.py
!/pre_experiment_tools/paired_detectability.py
!/pre_experiment_tools/test_paired_detectability.py

# Isolated error-aware guidance: publish only the reviewed artificial precheck.
!/exploration/
/exploration/*
!/exploration/error_guidance/
/exploration/error_guidance/*
!/exploration/error_guidance/README.md
!/exploration/error_guidance/RESEARCH_CONTRACT.md
!/exploration/error_guidance/OPUS_AUDIT.md
!/exploration/error_guidance/precheck.cpp
!/exploration/error_guidance/run_precheck.py
!/exploration/error_guidance/source_pins.json
!/exploration/error_guidance/precheck_run_20260924_01.json
!/exploration/error_guidance/timing_precheck.cpp
!/exploration/error_guidance/run_timing_precheck.py
!/exploration/error_guidance/TIMING_PRECHECK.md
!/exploration/error_guidance/timing_run_20260924_01.json
!/exploration/error_guidance/prefix_precheck.cpp
!/exploration/error_guidance/run_prefix_precheck.py
!/exploration/error_guidance/PREFIX_PRECHECK.md
!/exploration/error_guidance/prefix_run_20260924_01.json
!/exploration/error_guidance/prefix_run_20260924_02.json
!/exploration/error_guidance/MISMATCH_PRECHECK.md
!/exploration/error_guidance/mismatch_precheck.cpp
!/exploration/error_guidance/run_mismatch_precheck.py
!/exploration/error_guidance/mismatch_run_20260924_01.json
!/exploration/error_guidance/HISTORY_CALIBRATION_PRECHECK.md
!/exploration/error_guidance/history_calibration_precheck.cpp
!/exploration/error_guidance/run_history_calibration_precheck.py
!/exploration/error_guidance/history_calibration_run_20260924_01.json

# Archived tracked snapshots stay local for frozen evidence; do not re-add.
/[0-9]*
/README.md
/MANUSCRIPT_PREEXPERIMENT.md
/RESEARCH_BRIEF_FOR_ADVISOR.md
