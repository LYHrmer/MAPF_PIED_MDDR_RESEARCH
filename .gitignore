# Deny by default. Add exact, approved pre-experiment documents only.
*
!/.gitignore
!/.github/
!/GITHUB_PROGRESS.md
/.github/*
!/.github/README.md

# Pre-experiment statistics tools backing section 4.5. Directory re-denied so
# that only these named files enter; __pycache__ and unreviewed scripts stay out.
!/pre_experiment_tools/
/pre_experiment_tools/*
!/pre_experiment_tools/paired_hoeffding.py
!/pre_experiment_tools/test_paired_hoeffding.py
!/pre_experiment_tools/paired_detectability.py
!/pre_experiment_tools/test_paired_detectability.py

# Archived tracked snapshots stay local for frozen evidence; do not re-add.
/[0-9]*
/README.md
/MANUSCRIPT_PREEXPERIMENT.md
/RESEARCH_BRIEF_FOR_ADVISOR.md
